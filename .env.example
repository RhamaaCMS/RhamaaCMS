# RhamaaCMS — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Django
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Database: SQLite default in development; PostgreSQL required/recommended in production
# DATABASE_URL=postgresql://rhamaa:password@localhost:5432/rhamaa
DB_CONN_MAX_AGE=60

# MQTT Broker
# Default: EMQX public broker (for development only — messages are public!)
# For production use your own broker or EMQX Cloud
# disabled | embedded (single-process development) | worker (production)
MQTT_RUN_MODE=embedded
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=rhamaa-dev
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DEFAULT_TOPICS=

# Production broker security
MQTT_TLS_ENABLED=False
MQTT_TLS_CA_CERT=
MQTT_TLS_CERTFILE=
MQTT_TLS_KEYFILE=

# Redis (optional — only needed for multi-worker production)
# Required in production and for multiple web workers
# REDIS_URL=redis://localhost:6379/0
