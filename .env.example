# RhamaaCMS — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Django
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# MQTT Broker
# Default: EMQX public broker (for development only — messages are public!)
# For production use your own broker or EMQX Cloud
MQTT_ENABLED=True
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Redis (optional — only needed for multi-worker production)
# REDIS_URL=redis://localhost:6379/0
